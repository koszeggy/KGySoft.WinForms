<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--<TargetFrameworks>net35;net40;net47;netcoreapp3.0;netcoreapp3.1;net5.0-windows;net6.0-windows</TargetFrameworks>-->
    <TargetFrameworks>net35;net40;net47;net9.0-windows</TargetFrameworks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>KGySoft.WinForms.Example</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>Enable</Nullable>

    <NoWarn>$(NoWarn);WFO1000;CA1304</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KGySoft.WinForms\KGySoft.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Application.StringResources.resx">
      <LogicalName>KGySoft.WinForms.Example.StringResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Controls\LocalizableControlDemo.StringResources.resx">
      <LogicalName>KGySoft.WinForms.Example.Controls.LocalizableControlDemo.StringResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\frmEditResources.StringResources.resx">
      <LogicalName>KGySoft.WinForms.Example.Forms.frmEditResources.StringResources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\frmLocalizationExample.StringResources.resx">
      <LogicalName>KGySoft.WinForms.Example.Forms.frmLocalizationExample.StringResources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>