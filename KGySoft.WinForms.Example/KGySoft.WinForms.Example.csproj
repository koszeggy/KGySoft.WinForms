<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--NOTE: scaling of system button adapters is fixed in .NET 5.0+ -->
    <!--<TargetFrameworks>net35;net40;net47;net48;netcoreapp3.0;net7.0-windows</TargetFrameworks>-->
    <TargetFrameworks>net9.0-windows</TargetFrameworks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>KGySoft.WinForms.Example</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- .NET Framework only references -->
  <!--<ItemGroup Condition="'$(TargetFramework)'=='net35' OR '$(TargetFramework)'=='net40' OR '$(TargetFramework)'=='net45' OR '$(TargetFramework)'=='net48'">
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>-->
  <ItemGroup>
    <ProjectReference Include="..\KGySoft.WinForms\KGySoft.WinForms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Application.StringResources.resx">
      <LogicalName>KGySoft.WinForms.Example.StringResources.resources</LogicalName>
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Controls\LocalizableControlDemo.StringResources.resx">
      <LogicalName>KGySoft.WinForms.Example.Controls.LocalizableControlDemo.StringResources.resources</LogicalName>
      <Generator></Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="Forms\frmLocalizationExample.StringResources.resx">
      <LogicalName>KGySoft.WinForms.Example.Forms.frmLocalizationExample.StringResources.resources</LogicalName>
      <Generator></Generator>
    </EmbeddedResource>
  </ItemGroup>

</Project>