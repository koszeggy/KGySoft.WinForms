<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>KGySoft.WinForms</id>
    <version>5.0.0-rc.1</version>
    <title>KGy SOFT Windows Forms Libraries</title>
    <authors>György Kőszeg</authors>
    <owners>György Kőszeg</owners>
    <license type="file">LICENSE</license>
    <!--<projectUrl>https://kgysoft.net/winforms</projectUrl>-->
    <!--<iconUrl>https://kgysoft.net/images/Icon64.png</iconUrl>-->
    <icon>Icon64.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Advanced Windows Forms controls, components, forms and features with high backward OS and .NET Framework compatibility from Windows XP to Windows 11.</summary>
    <description xml:space="preserve">KGy SOFT Windows Forms Libraries offer advanced controls and components built around System.Windows.Forms types.

Among others:
- A BaseForm with command bindings, MDI application and dynamic localization support, fixing some high-DPI and multi-monitor issues also for older frameworks
- Task dialogs also with compatibility mode supporting even Windows XP
- Advanced components and controls that either extend existing functionality or add new ones
- Screenshot support

Find some more examples with images at the project site at https://github.com/koszeggy/KGySoft.WinForms</description>
    <releaseNotes>See the detailed release notes here: https://github.com/koszeggy/KGySoft.WinForms/blob/master/KGySoft.WinForms/changelog.txt</releaseNotes>
    <copyright>Copyright © KGy SOFT</copyright>
    <tags>KGySoft WinForms controls components TaskDialog forms</tags>
    <language>en-US</language>
    <repository type="git" url="https://github.com/koszeggy/KGySoft.WinForms" />
    <dependencies>
      <group targetFramework=".NETFramework3.5">
        <dependency id="KGySoft.Drawing" version="10.0.2" />
