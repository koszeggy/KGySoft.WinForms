<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--Explicitly targeted frameworks
      - net35/net40/netcoreapp3.0: The lowest supported versions of .NET Framework and .NET Core
      - net45: Not really needed explicitly, but it allows using Environment.CurrentManagedThreadId instead of the Thread class
      - net47: Needed to work around handle high DPI handling issues the .NET Framework introduced in 4.7
      - netcoreapp3.1: Needed because in .NET Core 3.1 several legacy controls have been removed that we handle in lower versions (e.g. for localization support)
      - net5.0:
        - to use [SupportedOSPlatform]
        - to omit the form sizing fix earlier versions had - https://github.com/dotnet/winforms/issues/1504
        - to apply a fix for a newly introduced bug present in .NET 5.0..9.0 - https://github.com/dotnet/winforms/issues/1378
      - net6.0:
        - to work around the changed (and buggy) high DPI handling when scaling fonts
        - to use Control.IsAncestorSiteInDesignMode
      - net9.0:
        - to use System.Threading.Lock
        - to allow using a workaround when the new dark mode is enabled
      - net10.0: to omit the workaround for the bug existed in .NET 5.0..9.0 - https://github.com/dotnet/winforms/issues/1378
    -->
    <TargetFrameworks>net35;net40;net45;net47;netcoreapp3.0;netcoreapp3.1;net5.0-windows;net6.0-windows;net9.0-windows;net10.0-windows</TargetFrameworks>
    <!--<TargetFrameworks>net9.0-windows</TargetFrameworks>-->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>KGySoft</RootNamespace>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\KGySoft.snk</AssemblyOriginatorKeyFile>
    <!--<RunCodeAnalysis>true</RunCodeAnalysis>-->
    <CodeAnalysisRuleSet>..\KGySoft.WinForms.ruleset</CodeAnalysisRuleSet>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--Suppressions
      - NETSDK1138: The target framework 'tfm' is out of support - this is not an application but a library so targeting the lowest possible versions is intended
    -->
    <NoWarn>$(NoWarn);WFO1000;WFO0003;WFAC010;NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.301">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="HelpOut\**" />
    <None Include="..\LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".nuspec\KGySoft.WinForms.nuspec" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="KGySoft.Drawing" Version="10.1.0" />
  </ItemGroup>

  <!-- .NET Framework only references -->
  <ItemGroup Condition="'$(TargetFramework)'=='net35' OR '$(TargetFramework)'=='net40' OR '$(TargetFramework)'=='net45' OR '$(TargetFramework)'=='net47'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Design" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WinForms\Controls\Resources\Toolbox.AdvancedLabel.png" />
    <EmbeddedResource Include="WinForms\Controls\Resources\Toolbox.AdvancedPanel.png" />
    <EmbeddedResource Include="WinForms\Controls\Resources\Toolbox.AdvancedTextBox.png" />
    <EmbeddedResource Include="WinForms\Controls\Resources\Toolbox.CheckGroupBox.png" />
    <EmbeddedResource Include="WinForms\Controls\Resources\Toolbox.CommandLinkButton.png" />
    <EmbeddedResource Include="WinForms\Controls\Resources\Toolbox.DecimalTextBox.png" />
    <EmbeddedResource Include="WinForms\Controls\Resources\Toolbox.OkCancelButtons.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="KGySoft.WinForms.Messages.resx">
      <LogicalName>KGySoft.WinForms.Messages.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>