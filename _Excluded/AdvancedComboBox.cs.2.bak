/*******************************************
 * AdvancedComboBox - KGy
 * 
 * Eredendõ problémák:
 * - A felirat színe Enabled = false-ra mindenképpen szürkül
 * 
 * Megoldás:
 * - DisabledBackColor: Háttérszín letiltott állapotban
 * - DisabledForeColor: Felirat színe letiltott állapotban
 * 
 * Extra fícsörök:
 * - Egy csomó LoadCombo metódus, ami a feltöltést biztosítja
 */

using System;
using System.Collections.Generic;
using System.Text;
using System.Windows.Forms;
using System.Drawing;
using System.ComponentModel;
using System.Data;
using System.Diagnostics;
using System.Windows.Forms.VisualStyles;
using KGySoft.Libraries.Reflection;

namespace KGySoft.Controls
{
    /// <summary>
    /// Advanced version of <see cref="ComboBox"/> control that supports customized coloring even in disabled state.
    /// Furthermore, supports numerous data-bound combo initializations.
    /// </summary>
    public class AdvancedComboBox: ComboBox, IDisabledColorCapable, IComboCapable
    {
        #region Fields

        private Color disabledBackColor = Color.FromName("Control");
        private Color disabledForeColor = Color.FromName("WindowText");
        private ComboBoxStyle style = ComboBoxStyle.DropDown;
        bool styleChanging = false;
        string textSaved = null;
        int indexSaved = -1;
        Bitmap bmpSaved;
        bool lastEnabled = true;
        private bool systemDrawDropDownListMode = true;

        #endregion

        #region Properties

        #region Overridden/reintroduced properties

        /// <summary>
        /// Gets or sets the text associated with this control.
        /// </summary>
        public override string Text
        {
            get
            {
                if (!Enabled)
                    return textSaved;
                else
                    return base.Text;
            }
            set
            {
                base.Text = value;
                if (!Enabled)
                {
                    indexSaved = -1;
                    textSaved = value;
                    SetPaintMode();
                }
            }
        }

        /// <summary>
        /// DrawMode is automatically managed in <see cref="AdvancedComboBox"/>.
        /// </summary>
        [Browsable(false)]
        [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
        public new DrawMode DrawMode
        {
            get { return base.DrawMode; }
            set { throw new InvalidOperationException("DrawMode cannot be set in AdvancedComboBox"); }
        }

        /// <summary>
        /// Gets or sets a value specifying the style of the combo box.
        /// </summary>
        [RefreshProperties(RefreshProperties.Repaint)]
        [Category("AdvancedComboBox")]
        [Description("Gets or sets a value specifying the style of the combo box.")]
        [DefaultValue(ComboBoxStyle.DropDown)]
        public new ComboBoxStyle DropDownStyle
        {
            get { return style; }
            set { base.DropDownStyle = value; }
        }

        #endregion

        #region New properties

        /// <summary>
        /// Gets or sets disabled fore color
        /// </summary>
        [Category("AdvancedComboBox")]
        [Description("Gets or sets disabled fore color.")]
        [DefaultValue(typeof(Color), "WindowText")]
        public Color DisabledForeColor
        {
            get { return disabledForeColor; }
            set
            {
                disabledForeColor = value;
                Invalidate();
            }
        }

        /// <summary>
        /// Gets or sets disabled back color
        /// </summary>
        [Category("AdvancedComboBox")]
        [Description("ets or sets disabled back color.")]
        [DefaultValue(typeof(Color), "Control")]
        public Color DisabledBackColor
        {
            get { return disabledBackColor; }
            set
            {
                disabledBackColor = value;
                Invalidate();
            }
        }

        /// <summary>
        /// Gets or sets whether the enabled combo box should be drawn by the system in <see cref="ComboBoxStyle.DropDownList"/> mode.
        /// If this property is <c>true</c>, then the enabled drop down list appearance will look like in case of
        /// the regular <see cref="ComboBox"/>, while in case of <c>false</c> background color of the control will
        /// be the same as <see cref="Control.BackColor"/> of the control.
        /// </summary>
        [Category("AdvancedComboBox")]
        [Description("Gets or sets whether the enabled combo box should be drawn by the system in DropDownList mode." +
        " If this property is true, then the enabled drop down list appearance will look like in case of" +
        " the regular ComboBox, while in case of false background color of the control will" +
        " be the same as BackColor of the control.")]
        [DefaultValue(true)]
        public bool SystemDrawDropDownListMode
        {
            get { return systemDrawDropDownListMode; }
            set
            {
                systemDrawDropDownListMode = value;
                AdjustDrawMode();
            }
        }

        #endregion

        #endregion

        #region Constructor

        public AdvancedComboBox()
        {
            EnabledChanged += new EventHandler(AdvancedComboBox_EnabledChanged);
            DropDownStyleChanged += new EventHandler(AdvancedComboBox_DropDownStyleChanged);
            SelectedIndexChanged += new EventHandler(AdvancedComboBox_SelectedIndexChanged);
            SystemColorsChanged += new EventHandler(AdvancedComboBox_SystemColorsChanged);
            if (!DesignMode)
                SetPaintMode();
        }

        #endregion

        #region Methods

        #region Protected methods

        protected override void Dispose(bool disposing)
        {
            base.Dispose(disposing);
            if (disposing)
            {
                if (bmpSaved != null)
                    bmpSaved.Dispose();
            }
        }

        /// <summary>
        /// Draws an item in the dropdown area and also in the control area in dropdownlist mode.
        /// Works only if DrawMode is OwnerDrawFixed.
        /// </summary>
        [DebuggerStepThrough]
        protected override void OnDrawItem(DrawItemEventArgs e)
        {
            // drawing an item in the dropdown area
            if (e.Index >= 0)
            {
                string label = GetItemText(Items[e.Index]);
                bool dispose = true;

                Brush brFore;
                Brush brBack;
                //// Disabled combo (dropdownlist mode)
                //if ((int)(e.State & DrawItemState.Disabled) > 0)
                //{
                //    brFore = new SolidBrush(disabledForeColor);
                //    brBack = new SolidBrush(disabledBackColor);
                //} else
                // Non focused list item
                if ((int)(e.State & DrawItemState.Selected) == 0)
                {
                    brFore = new SolidBrush(ForeColor);
                    brBack = new SolidBrush(BackColor);
                }
                // Focused list item
                else
                {
                    brFore = SystemBrushes.HighlightText;
                    brBack = SystemBrushes.Highlight;
                    dispose = false;
                }
                e.Graphics.FillRectangle(brBack, e.Bounds);
                e.Graphics.DrawString(label, e.Font, brFore, e.Bounds.Left - 2, e.Bounds.Top);
                e.DrawFocusRectangle();
                if (dispose)
                {
                    brFore.Dispose();
                    brBack.Dispose();
                }
            }
            // drawing the unselected control in dropdownlist mode
            else
            {
                base.OnDrawItem(e);
            }
        }

        /// <summary>
        /// Drawing appearance in disabled mode (works only in DropDownList mode)
        /// </summary>
        [DebuggerStepThrough]
        protected override void OnPaint(PaintEventArgs e)
        {
            base.OnPaint(e);
            if (!this.Enabled)
            {
                Graphics g = e.Graphics;

                // This would be easy but actually will be very ugly:
                //// drawing textbox with text
                //Rectangle rectangle = ClientRectangle;
                //if (style != ComboBoxStyle.Simple)
                //    rectangle.Width -= 16;
                //ComboBoxRenderer.DrawTextBox(g, rectangle, textSaved, Font, ComboBoxState.Disabled);

                //// drawing button
                //if (style != ComboBoxStyle.Simple)
                //    ComboBoxRenderer.DrawDropDownButton(g, new Rectangle(ClientRectangle.Width - 16, 0, 16, ClientRectangle.Height), ComboBoxState.Disabled);

                // saving the disabled image of the control (this saves a dropdownlist appearance)
                if (bmpSaved == null)
                {
                    SetStyle(ControlStyles.UserPaint, false);
                    bmpSaved = new Bitmap(Width, Height);
                    DrawToBitmap(bmpSaved, ClientRectangle);
                    SetStyle(ControlStyles.UserPaint, true);
                }

                // drawing background
                g.DrawImage(bmpSaved, 0, 0);

                // filling with disabled background
                Rectangle rectangle = ClientRectangle;
                rectangle.X += 2;
                rectangle.Y += 2;
                rectangle.Width -= 4;
                rectangle.Height -= 4;
                if (style != ComboBoxStyle.Simple)
                    rectangle.Width -= 16; // assuming that dropdown button is 16 px wide
                using (Brush b = new SolidBrush(disabledBackColor))
                {
                    g.FillRectangle(b, rectangle);
                }

                // drawing text
                TextRenderer.DrawText(g, textSaved, Font, rectangle, disabledForeColor, TextFormatFlags.VerticalCenter | TextFormatFlags.Left | TextFormatFlags.SingleLine);
            }
        }

        #endregion

        #region Private Methods

        private void SetPaintMode()
        {
            bool userPaint = !Enabled && (style != ComboBoxStyle.DropDownList || SelectedIndex >= 0);
            SetStyle(ControlStyles.UserPaint, userPaint);
            Invalidate();
        }

        private void AdjustDrawMode()
        {
            bool customDraw = !Enabled || style != ComboBoxStyle.DropDownList || !systemDrawDropDownListMode;
            base.DrawMode = customDraw ? DrawMode.OwnerDrawFixed : DrawMode.Normal;
        }

        #endregion

        #region Handled events

        void AdvancedComboBox_EnabledChanged(object sender, EventArgs e)
        {
            styleChanging = true;
            try
            {
                if (lastEnabled == Enabled) // sajnos nem csak változáskor fut le (pl. parent enabled majd saját enabled = false-ra is)
                    return;
                lastEnabled = Enabled;
                if (Enabled)
                {
                    base.DropDownStyle = style;
                    SetPaintMode();
                    if (indexSaved >= 0)
                    {
                        if (indexSaved < base.Items.Count)
                            SelectedIndex = indexSaved;
                    }
                    else if (textSaved != null)
                        base.Text = textSaved;
                    Font font = Font;
                    // ReSharper disable AssignNullToNotNullAttribute
                    Font = null;
                    // ReSharper restore AssignNullToNotNullAttribute
                    Font = font; // Without these lines font would be replaced to some bold one after Enabled off->on
                    if (!Focused)
                        SelectionLength = 0; // enélkül meg néha kijelölve marad akkor is, ha nincs fókuszban
                    Invalidate(); // Without this text wouldn't appear after Enabled off->on
                }
                else
                {
                    style = base.DropDownStyle;
                    indexSaved = SelectedIndex;
                    textSaved = base.Text;
                    base.DropDownStyle = ComboBoxStyle.DropDownList; // OnPaint works only in this mode. But Text may be lost so it will be saved into TextSaved

                    SetPaintMode();
                }
            }
            finally
            {
                styleChanging = false;
            }
        }

        void AdvancedComboBox_DropDownStyleChanged(object sender, EventArgs e)
        {
            if (styleChanging)
                return;
            style = base.DropDownStyle;

            AdjustDrawMode();
            if (!Enabled)
            {
                styleChanging = true;
                base.DropDownStyle = ComboBoxStyle.DropDownList;
                styleChanging = false;
            }
            SetPaintMode();
        }

        void AdvancedComboBox_SelectedIndexChanged(object sender, EventArgs e)
        {
            if (styleChanging) return;
            SetPaintMode();
        }

        void AdvancedComboBox_SystemColorsChanged(object sender, EventArgs e)
        {
            if (bmpSaved != null)
            {
                bmpSaved.Dispose();
                bmpSaved = null;
            }
        }

        #endregion

        #endregion

        #region IComboCapable Members

        /// <summary>
        /// Gets whether the there is no selected item in the combo box (<see cref="SelectedValue"/> or is <see langword="null"/>, <see cref="DBNull"/> or equals with <see cref="ControlUtils.NotSelectedValue"/>)
        /// </summary>
        public bool IsEmpty
        {
            get { return this.IsEmpty(); }
        }

        /// <summary>
        /// Binds the combo box to a <see cref="DataTable"/>.
        /// </summary>
        /// <param name="dataTable">The data source table.</param>
        /// <param name="displayMember">Column name to display in the the combo box.</param>
        /// <param name="valueMember">Column name to use as the actual value for the items in the combo box.</param>
        /// <param name="translateNames">Indicates whether the displayed values should be translated. If so, the displayed column must contain string values.</param>
        /// <param name="distinctionPostfix">Distinction postfix for translated items. Can be <see langword="null"/> to omit distinction.</param>
        /// <param name="sortByDisplayedValues">If <c>true</c>, then items will be sorted by displayed values. Requested <paramref name="plusItems"/> will always be the first items.</param>
        /// <param name="plusItems">Requested additional items (Not selected/All/None). If <see cref="ComboPlusItems.ItemAll"/> or <see cref="ComboPlusItems.ItemNone"/> is requested,
        /// then the value column must have a data type that is convertible to signed integer type.</param>
        public void LoadCombo(DataTable dataTable, string valueMember, string displayMember, bool translateNames, string distinctionPostfix, bool sortByDisplayedValues, ComboPlusItems plusItems)
        {
            ComboUtils.LoadCombo(this, dataTable, valueMember, displayMember, translateNames, distinctionPostfix, sortByDisplayedValues, plusItems);
        }

        /// <summary>
        /// Binds the combo box to a <see cref="DataTable"/>. Items will not be sorted and only the <paramref name="plusItems"/> will be translated.
        /// </summary>
        /// <param name="dataTable">The data source table.</param>
        /// <param name="displayMember">Column name to display in the the combo box.</param>
        /// <param name="valueMember">Column name to use as the actual value for the items in the combo box.</param>
        /// <param name="plusItems">Requested additional items (Not selected/All/None). If <see cref="ComboPlusItems.ItemAll"/> or <see cref="ComboPlusItems.ItemNone"/> is requested,
        /// then the value column must have a data type that is convertible to signed integer type.</param>
        public void LoadCombo(DataTable dataTable, string valueMember, string displayMember, ComboPlusItems plusItems)
        {
            ComboUtils.LoadCombo(this, dataTable, valueMember, displayMember, plusItems);
        }

        /// <summary>
        /// Binds the combo box to a <see cref="DataTable"/>. Items will not be sorted and translated.
        /// </summary>
        /// <param name="dataTable">The data source table.</param>
        /// <param name="displayMember">Column name to display in the the combo box.</param>
        /// <param name="valueMember">Column name to use as the actual value for the items in the combo box.</param>
        public void LoadCombo(DataTable dataTable, string valueMember, string displayMember)
        {
            ComboUtils.LoadCombo(this, dataTable, valueMember, displayMember);
        }

        /// <summary>
        /// Binds the combo box to the values of an <see cref="Enum"/>.
        /// </summary>
        /// <param name="enumType">An <see cref="Enum"/> type with the fields to bind.</param>
        /// <param name="valueMemberType">Type of the actual value for the items in the combo box. If <see langword="null"/>, then original enum value will used as value member.</param>
        /// <param name="translateNames">Indicates whether the displayed enum field names should be translated.</param>
        /// <param name="distinctionPostfix">Distinction postfix for translated items. Can be <see langword="null"/> to omit distinction.</param>
        /// <param name="sortByDisplayedValues">If <c>true</c>, then items will be sorted by displayed values. Requested <paramref name="plusItems"/> will always be the first items.</param>
        /// <param name="plusItems">Requested additional items (Not selected/All/None). If <see cref="ComboPlusItems.ItemAll"/> or <see cref="ComboPlusItems.ItemNone"/> is requested,
        /// then the <paramref name="valueMemberType"/> must be a signed integer type or an enum with signed underlying type.</param>
        public void LoadCombo(Type enumType, Type valueMemberType, bool translateNames, string distinctionPostfix, bool sortByDisplayedValues, ComboPlusItems plusItems)
        {
            ComboUtils.LoadCombo(this, enumType, valueMemberType, translateNames, distinctionPostfix, sortByDisplayedValues, plusItems);
        }

        /// <summary>
        /// Binds the combo box to the values of an <see cref="Enum"/>. Items will not be sorted and only the <paramref name="plusItems"/> will be translated.
        /// </summary>
        /// <param name="enumType">An <see cref="Enum"/> type with the fields to bind.</param>
        /// <param name="valueMemberType">Type of the actual value for the items in the combo box. If <see langword="null"/>, then original enum value will used as value member.</param>
        /// <param name="plusItems">Requested additional items (Not selected/All/None). If <see cref="ComboPlusItems.ItemAll"/> or <see cref="ComboPlusItems.ItemNone"/> is requested,
        /// then the <paramref name="valueMemberType"/> must be a signed integer type or an enum with signed underlying type.</param>
        public void LoadCombo(Type enumType, Type valueMemberType, ComboPlusItems plusItems)
        {
            ComboUtils.LoadCombo(this, enumType, valueMemberType, plusItems);
        }

        /// <summary>
        /// Binds the combo box to the values of an <see cref="Enum"/>. Items will not be sorted and translated.
        /// </summary>
        /// <param name="enumType">An <see cref="Enum"/> type with the fields to bind.</param>
        /// <param name="valueMemberType">Type of the actual value for the items in the combo box. If <see langword="null"/>, then original enum value will used as value member.</param>
        public void LoadCombo(Type enumType, Type valueMemberType)
        {
            ComboUtils.LoadCombo(this, enumType, valueMemberType);
        }

        /// <summary>
        /// Binds the combo box to the values of an <see cref="Enum"/>. Items will not be sorted and translated.
        /// </summary>
        /// <param name="enumType">An <see cref="Enum"/> type with the fields to bind.</param>
        public void LoadCombo(Type enumType)
        {
            ComboUtils.LoadCombo(this, enumType);
        }

        /// <summary>
        /// Binds the combo box to a <paramref name="collection"/>.
        /// </summary>
        /// <param name="collection">The source collection.</param>
        /// <param name="displayMember">Property name to display in the the combo box.</param>
        /// <param name="valueMember">Property name to use as the actual value for the items in the combo box.</param>
        /// <param name="translateNames">Indicates whether the displayed values should be translated. If so, <paramref name="displayMember"/> must be writable and should refer to a <see cref="string"/> property.</param>
        /// <param name="distinctionPostfix">Distinction postfix for translated items. Can be <see langword="null"/> to omit distinction.</param>
        /// <param name="sortByDisplayedValues">If <c>true</c>, then items will be sorted by displayed values. Requested <paramref name="plusItems"/> will always be the first items.</param>
        /// <param name="plusItems">Requested additional items (Not selected/All/None). If plus itmes are requested, then <paramref name="valueMember"/> must refer to a property,
        /// which is convertible to signed integer type.</param>
        public void LoadCombo<T>(IEnumerable<T> collection, string valueMember, string displayMember, bool translateNames, string distinctionPostfix, bool sortByDisplayedValues, ComboPlusItems plusItems)
        {
            ComboUtils.LoadCombo(this, collection, valueMember, displayMember, translateNames, distinctionPostfix, sortByDisplayedValues, plusItems);
        }

        /// <summary>
        /// Binds the combo box to a <paramref name="collection"/>. Items will not be sorted and only the <paramref name="plusItems"/> will be translated.
        /// </summary>
        /// <param name="collection">The source collection.</param>
        /// <param name="displayMember">Property name to display in the the combo box.</param>
        /// <param name="valueMember">Property name to use as the actual value for the items in the combo box.</param>
        /// <param name="plusItems">Requested additional items (Not selected/All/None). If plus itmes are requested, then <paramref name="valueMember"/> must refer to a property,
        /// which is convertible to signed integer type.</param>
        public void LoadCombo<T>(IEnumerable<T> collection, string valueMember, string displayMember, ComboPlusItems plusItems)
        {
            ComboUtils.LoadCombo(this, collection, valueMember, displayMember, plusItems);
        }

        /// <summary>
        /// Binds the combo box to a <paramref name="collection"/>. Items will not be sorted and translated.
        /// </summary>
        /// <param name="collection">The source collection.</param>
        /// <param name="displayMember">Property name to display in the the combo box.</param>
        /// <param name="valueMember">Property name to use as the actual value for the items in the combo box.</param>
        public void LoadCombo<T>(IEnumerable<T> collection, string valueMember, string displayMember)
        {
            ComboUtils.LoadCombo(this, collection, valueMember, displayMember);
        }

        #endregion
    }
}
